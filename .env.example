DATABASE_URL=postgresql://postgres.[project-ref]:[database-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=verify-full
# Required in production: either point at Supabase's downloaded root CA cert...
SUPABASE_DB_CA_CERT=/absolute/path/to/supabase-root.crt
# ...or provide the PEM contents directly.
# SUPABASE_DB_CA_CERT_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
APP_ORIGIN=https://your-domain.example
